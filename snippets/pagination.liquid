{% doc %}
  Renders pagination controls for a paginate block. Must be rendered inside
  {% paginate %}...{% endpaginate %}.

  @param {object} paginate - the paginate object
  @param {string} [anchor] - anchor to append to page links, e.g. '#product-grid'
{% enddoc %}

{%- if paginate.pages > 1 -%}
  <nav
    class="flex w-full items-center justify-center gap-1 pt-8"
    role="navigation"
    aria-label="{{ 'general.pagination.label' | t }}"
  >
    {%- if paginate.previous -%}
      <a
        href="{{ paginate.previous.url }}{{ anchor }}"
        class="flex h-10 min-w-10 items-center justify-center rounded border px-2 transition hover:bg-primary/5"
        aria-label="{{ 'general.pagination.previous' | t }}"
      >
        <span class="rotate-90">{% render 'icon-caret' %}</span>
      </a>
    {%- endif -%}

    {%- for part in paginate.parts -%}
      {%- if part.is_link -%}
        <a
          href="{{ part.url }}{{ anchor }}"
          class="flex h-10 min-w-10 items-center justify-center rounded border px-2 transition hover:bg-primary/5"
          aria-label="{{ 'general.pagination.page' | t: number: part.title }}"
        >
          {{- part.title -}}
        </a>
      {%- elsif part.title == paginate.current_page -%}
        <span
          class="flex h-10 min-w-10 items-center justify-center rounded border border-primary bg-primary px-2 text-contrast"
          aria-current="page"
          aria-label="{{ 'general.pagination.page' | t: number: part.title }}"
        >
          {{- part.title -}}
        </span>
      {%- else -%}
        <span class="flex h-10 min-w-10 items-center justify-center px-2 text-primary/50">{{ part.title }}</span>
      {%- endif -%}
    {%- endfor -%}

    {%- if paginate.next -%}
      <a
        href="{{ paginate.next.url }}{{ anchor }}"
        class="flex h-10 min-w-10 items-center justify-center rounded border px-2 transition hover:bg-primary/5"
        aria-label="{{ 'general.pagination.next' | t }}"
      >
        <span class="-rotate-90">{% render 'icon-caret' %}</span>
      </a>
    {%- endif -%}
  </nav>
{%- endif -%}
