{% doc %}
  Single source of truth for global data exposed to JavaScript. Rendered in
  the <head> of every layout (theme.liquid, password.liquid) before the Vite
  entrypoint, so islands can rely on these being defined at hydration time.

  Add new JS-accessible globals here — not as inline <script> blocks in
  layouts or sections. Typed in frontend/types/globals.d.ts; keep the two in
  sync.
{% enddoc %}
<script>
  window.routes = {
    cart_url: '{{ routes.cart_url }}',
    cart_add_url: '{{ routes.cart_add_url }}',
    cart_change_url: '{{ routes.cart_change_url }}',
    cart_update_url: '{{ routes.cart_update_url }}'
  }

  window.cartStrings = {
    error: `{{ 'sections.cart.cart_error' | t }}`,
    quantityError: `{{ 'sections.cart.cart_quantity_error_html' | t: quantity: '[quantity]' }}`,
    added: `{{ 'accessibility.cart_announcements.added' | t }}`,
    removed: `{{ 'accessibility.cart_announcements.removed' | t }}`,
    updated: `{{ 'accessibility.cart_announcements.updated' | t }}`
  }

  window.variantStrings = {
    addToCart: `{{ 'products.product.add_to_cart' | t }}`,
    soldOut: `{{ 'products.product.sold_out' | t }}`,
    unavailable: `{{ 'products.product.unavailable' | t }}`
  }

  window.__theme = {
    klaviyo: {
      listId: {{ settings.klaviyo_list_id | json }}
    }
  }
</script>
