{% doc %}
  Renders a single cart line item. Shared by the cart drawer
  (snippets/cart-drawer.liquid) and the cart page (blocks/cart-products.liquid).

  Element IDs differ per context and are targeted by
  frontend/islands/cart-items.ts — do not change them without updating the JS.

  @param {object} item - cart line item
  @param {boolean} [drawer] - true when rendered inside the cart drawer
{% enddoc %}

{%- liquid
  assign line = item.index | plus: 1
  if drawer
    assign item_id = 'CartDrawer-Item-' | append: line
    assign qty_id = 'Drawer-quantity-' | append: line
    assign remove_id = 'CartDrawer-Remove-' | append: line
    assign error_id = 'CartDrawer-LineItemError-' | append: line
    assign no_js_class = ''
  else
    assign item_id = 'CartItem-' | append: line
    assign qty_id = 'Quantity-' | append: line
    assign remove_id = 'Remove-' | append: line
    assign error_id = 'Line-item-error-' | append: line
    assign no_js_class = 'no-js:hidden '
  endif
-%}

<div id="{{ item_id }}" class="cart-item grid grid-cols-[auto_1fr] gap-4">
  <div class="relative flex-shrink">
    {% if item.image %}
      {% # Leave empty space due to a:empty CSS display: none rule %}
      <a href="{{ item.url }}" class="absolute inset-0 h-full w-full" tabindex="-1" aria-hidden="true"> </a>
      <img
        class="h-24 w-24 rounded border object-cover object-center md:h-28 md:w-28"
        src="{{ item.image | image_url: width: 224 }}"
        srcset="{{ item.image | image_url: width: 112 }} 112w, {{ item.image | image_url: width: 224 }} 224w"
        sizes="(min-width: 768px) 112px, 96px"
        alt="{{ item.image.alt | escape }}"
        loading="lazy"
        width="112"
        height="{{ 112 | divided_by: item.image.aspect_ratio | ceil }}"
      >
    {% endif %}
  </div>
  <div class="flex flex-grow justify-between">
    <div class="grid gap-2">
      <h3 class="max-w-prose text-copy font-body-weight-bold whitespace-pre-wrap">
        <a class="cart-item-name" href="{{ item.url }}">{{ item.product.title | escape }}</a>
      </h3>
      {%- if item.product.has_only_default_variant == false
        or item.properties.size != 0
        or item.selling_plan_allocation != null
      -%}
        <div class="pb-2">
          <dl class="grid">
            {%- if item.product.has_only_default_variant == false -%}
              {%- for option in item.options_with_values -%}
                <div class="flex max-w-prose text-copy whitespace-pre-wrap text-primary/50">
                  <dt>{{ option.name }}:</dt>
                  <dd>{{ option.value }}</dd>
                </div>
              {%- endfor -%}
            {%- endif -%}

            {%- for property in item.properties -%}
              {%- assign property_first_char = property.first | slice: 0 -%}
              {%- if property.last != blank and property_first_char != '_' -%}
                <div class="flex max-w-prose text-copy whitespace-pre-wrap text-primary/50">
                  <dt>{{ property.first }}:</dt>
                  <dd>
                    {%- if property.last contains '/uploads/' -%}
                      <a
                        href="{{ property.last }}"
                        class="link"
                        target="_blank"
                        aria-describedby="a11y-new-window-message"
                      >
                        {{ property.last | split: '/' | last }}
                      </a>
                    {%- else -%}
                      {{ property.last }}
                    {%- endif -%}
                  </dd>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </dl>

          <p class="flex max-w-prose text-copy whitespace-pre-wrap text-primary/50">
            {{ item.selling_plan_allocation.selling_plan.name }}
          </p>

          <ul role="list" aria-label="{{ 'customer.order.discount' | t }}">
            {%- for discount in item.discounts -%}
              <li class="flex items-center gap-2 text-primary/50">
                {%- render 'icon-discount' -%}
                {{ discount.title }}
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      <div class="flex items-center gap-2">
        <quantity-input
          class="flex min-h-[theme(spacing.10)] max-w-[107px] rounded border"
          {% if drawer %}
            client:idle
          {% endif %}
        >
          <button
            class="{{ no_js_class }}h-10 w-10 shrink-0 text-primary/50 transition hover:text-primary disabled:cursor-wait"
            type="button"
            name="minus"
            aria-label="{{ 'products.product.quantity.decrease' | t: product: item.product.title | escape }}"
          >
            &#8722;
          </button>
          <input
            class="w-full flex-grow border-0 bg-transparent p-0 text-center"
            type="number"
            name="updates[]"
            value="{{ item.quantity }}"
            min="0"
            aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}"
            id="{{ qty_id }}"
            data-index="{{ line }}"
          >
          <button
            class="{{ no_js_class }}h-10 w-10 shrink-0 text-primary/50 transition hover:text-primary disabled:cursor-wait"
            type="button"
            name="plus"
            aria-label="{{ 'products.product.quantity.increase' | t: product: item.product.title | escape }}"
          >
            &#43;
          </button>
        </quantity-input>

        <cart-remove-button
          id="{{ remove_id }}"
          data-index="{{ line }}"
        >
          {%- if drawer -%}
            <button
              type="button"
              class="flex h-10 w-10 items-center justify-center rounded border"
              aria-label="{{ 'sections.cart.remove_title' | t: title: item.title }}"
            >
              {% render 'icon-remove' %}
            </button>
          {%- else -%}
            <a
              href="{{ item.url_to_remove }}"
              class="flex h-10 w-10 items-center justify-center rounded border"
              aria-label="{{ 'sections.cart.remove_title' | t: title: item.title }}"
            >
              {% render 'icon-remove' %}
            </a>
          {%- endif -%}
        </cart-remove-button>
      </div>
    </div>
    <div class="relative text-copy">
      <div class="loading-overlay absolute top-0 right-0 hidden">
        {% render 'icon-spinner' %}
      </div>
      {%- if item.original_line_price != item.final_line_price -%}
        <div class="grid text-right [.loading-overlay:not(.hidden)_+_&]:invisible">
          <span class="sr-only">{{ 'products.product.price.regular_price' | t }}</span>
          <s class="text-primary/50">{{ item.original_line_price | money }}</s>
          <span class="sr-only">{{ 'products.product.price.sale_price' | t }}</span>
          <span>{{ item.final_line_price | money }}</span>
        </div>
      {%- else -%}
        <div>
          {{ item.original_line_price | money }}
        </div>
      {%- endif -%}
    </div>
  </div>

  <p
    id="{{ error_id }}"
    class="col-span-2 text-copy text-primary/50 text-red-500"
    role="alert"
  ></p>
</div>
