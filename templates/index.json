{
  "sections": {
    "image_banner": {
      "type": "image-banner",
      "settings": {
        "heading": "Image banner",
        "description": "Give customers details about the banner image(s) or content on the template.",
        "button_label": "Shop all →",
        "button_link": "shopify://collections/all",
        "button_style": "text"
      }
    },
    "featured_collection": {
      "type": "featured-collection",
      "blocks": {
        "heading": {
          "type": "heading",
          "static": true,
          "settings": {
            "heading": "Featured collection",
            "heading_level": "h2",
            "heading_size": "md"
          }
        },
        "static-product-card": {
          "type": "product-card",
          "static": true,
          "settings": {
            "product": "{{ closest.product }}"
          },
          "blocks": {
            "heading": {
              "type": "text",
              "static": true,
              "settings": {
                "text": "<p>{{ closest.product.title }}</p>"
              }
            },
            "price": {
              "type": "price",
              "static": true,
              "id": "price",
              "settings": {
                "product": "{{ closest.product }}"
              }
            },
            "image": {
              "type": "image",
              "static": true,
              "id": "image",
              "settings": {
                "image": "{{ closest.product.featured_image }}"
              }
            }
          }
        }
      },
      "settings": {
        "collection": "all",
        "products_to_show": 8
      }
    },
    "collection_list": {
      "type": "collection-list",
      "blocks": {
        "heading": {
          "type": "heading",
          "static": true,
          "id": "heading",
          "settings": {
            "heading": "Collections",
            "heading_level": "h2",
            "heading_size": "md"
          }
        },
        "collection-card": {
          "type": "collection-card",
          "id": "collection-card",
          "static": true,
          "settings": {
            "collection": "{{ closest.collection }}"
          },
          "blocks": {
            "image": {
              "type": "image",
              "static": true,
              "id": "image",
              "settings": {
                "image": "{{ closest.collection.image }}"
              }
            },
            "heading": {
              "type": "heading",
              "static": true,
              "id": "heading",
              "settings": {
                "heading": "{{ closest.collection.title }}"
              }
            }
          }
        }
      }
    }
  },
  "order": ["image_banner", "featured_collection", "collection_list"]
}
