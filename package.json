{
  "name": "hygrogen-theme",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite & shopify theme dev -s progresslabs-functions",
    "build": "npm run typecheck && vitest run && vite build",
    "deploy": "npm run typecheck && vitest run && npm run build && shopify theme push",
    "lint": "eslint .",
    "format": "prettier --write --cache .",
    "format-check": "prettier --check .",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@driver-digital/vite-plugin-shopify-clean": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@shopify/prettier-plugin-liquid": "^1.11.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vite-plugin-shopify": "^4.1.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@sentry/browser": "^10.69.0",
    "klaviyo-subscribe": "^1.0.0"
  },
  "overrides": {
    "liquidjs": "^10.28.0",
    "lodash": "^4.18.1",
    "form-data": "^4.0.6"
  }
}
