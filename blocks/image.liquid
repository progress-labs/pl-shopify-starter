{%- doc -%}
  Renders an image element.

  @param {boolean} [lazy_load] - defaults to lazy; pass false for above-the-fold images
  @param {string} [sizes] - sizes attribute; defaults to '320px' (card swimlane). Pass the real rendered width from grid/hero contexts, e.g. '(min-width: 1024px) 25vw, 50vw'
  @param {string} [fetchpriority] - pass 'high' for the likely LCP image
{%- enddoc -%}

{%- liquid
  assign image = block.settings.image
  assign sizes = sizes | default: '320px'
-%}

{%- if block.settings.image -%}
  {%- # theme-check-disable ImgLazyLoading -%}
  <img
    srcset="
      {%- if image.width >= 165 -%}{{ image | image_url: width: 165 }} 165w,{%- endif -%}
      {%- if image.width >= 360 -%}{{ image | image_url: width: 360 }} 360w,{%- endif -%}
      {%- if image.width >= 533 -%}{{ image | image_url: width: 533 }} 533w,{%- endif -%}
      {%- if image.width >= 720 -%}{{ image | image_url: width: 720 }} 720w,{%- endif -%}
      {%- if image.width >= 940 -%}{{ image | image_url: width: 940 }} 940w,{%- endif -%}
      {%- if image.width >= 1066 -%}{{ image | image_url: width: 1066 }} 1066w,{%- endif -%}
      {%- if image.width >= 1500 -%}{{ image | image_url: width: 1500 }} 1500w,{%- endif -%}
      {%- if image.width >= 2000 -%}
        {{ image | image_url: width: 2000 }} 2000w
      {%- else -%}
        {{ image | image_url: width: image.width }} {{ image.width }}w
      {%- endif -%}
    "
    src="{{ image | image_url: width: 533 }}"
    sizes="{{ sizes }}"
    alt="{{ image.alt | escape }}"
    class="aspect-[inherit] h-full w-full object-cover object-center"
    {% unless lazy_load == false %}
      loading="lazy"
    {% endunless %}
    {% if fetchpriority == 'high' %}
      fetchpriority="high"
    {% endif %}
    width="{{ image.width }}"
    height="{{ image.height }}"
    {{ block.shopify_attributes }}
  >
  {%- # theme-check-enable ImgLazyLoading -%}
{%- endif -%}

{% schema %}
{
  "name": "Image",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
  ]
}
{% endschema %}
