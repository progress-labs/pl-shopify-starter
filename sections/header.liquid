{%- liquid
  assign container_class = 'bg-contrast/80 text-primary'
  assign input_class = 'focus:border-primary/20'

  assign header_tag = 'div'
  if section.settings.enable_sticky_header
    assign header_tag = 'sticky-header'
  endif
-%}

<{{ header_tag }}
  {% if header_tag == 'sticky-header' %}
    client:idle
  {% endif %}
>
  <header
    role="banner"
    class="{{ container_class }} flex h-nav w-full items-center justify-between gap-4 px-4 leading-none backdrop-blur-lg md:px-8 lg:gap-8 lg:px-12 lg:py-8"
  >
    <div class="flex w-full items-center justify-start gap-4 lg:hidden">
      {%- content_for 'block', type: 'header-menu', id: 'header-menu', variant: 'mobile' -%}

      <form
        action="{{ routes.search_url }}"
        method="get"
        role="search"
        class="w-full max-w-[335px] items-center gap-2 sm:flex"
      >
        <input type="hidden" name="type" value="product">

        <button type="submit" class="flex h-8 w-8 items-center justify-center">
          {% render 'icon-search' %}
          <span class="sr-only">{{ 'general.search.search' | t }}</span>
        </button>

        <input
          class="{{ input_class }} -mb-px hidden appearance-none border-x-0 border-t-0 border-b border-transparent bg-transparent px-0 py-1 text-left transition placeholder:text-inherit placeholder:opacity-20 focus:ring-transparent md:inline-block lg:text-right"
          type="search"
          name="q"
          placeholder="{{ 'general.search.search' | t }}"
        >
      </form>
    </div>

    <div class="flex w-full items-center gap-12 lg:w-auto">
      {%- content_for 'block', type: '_header-logo', id: 'header-logo' -%}

      {%- # theme-check-disable UniqueStaticBlockId -%}
      {%- content_for 'block', type: 'header-menu', id: 'header-menu' -%}
      {%- # theme-check-enable UniqueStaticBlockId -%}
    </div>

    <div class="flex w-full items-center justify-end gap-4 lg:w-auto lg:gap-1">
      <form action="{{ routes.search_url }}" method="get" role="search" class="hidden items-center gap-2 lg:flex">
        <input
          class="{{ input_class }} -mb-px hidden appearance-none border-x-0 border-t-0 border-b border-transparent bg-transparent px-0 py-1 text-left transition placeholder:text-inherit placeholder:opacity-20 focus:ring-transparent md:inline-block lg:text-right"
          type="search"
          name="q"
          placeholder="{{ 'general.search.search' | t }}"
        >

        <button type="submit" class="flex h-8 w-8 items-center justify-center">
          {% render 'icon-search' %}
          <span class="sr-only">{{ 'general.search.search' | t }}</span>
        </button>
      </form>

      {%- if shop.customer_accounts_enabled -%}
        <a
          href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
          class="flex h-8 w-8 items-center justify-center"
        >
          {% render 'icon-account' %}
          <span class="sr-only">
            {%- liquid
              if customer
                echo 'customer.account_fallback' | t
              else
                echo 'customer.log_in' | t
              endif
            -%}
          </span>
        </a>
      {%- endif -%}

      <a href="{{ routes.cart_url }}" class="relative flex h-8 w-8 items-center justify-center" id="cart-icon-bubble">
        {%- render 'cart-icon-bubble' -%}
      </a>
    </div>
  </header>
</{{ header_tag }}>

{%- liquid
  # Only emit configured social links — blank entries are invalid sameAs values.
  assign social_handles = 'twitter,facebook,pinterest,instagram,tiktok,tumblr,snapchat,youtube,vimeo' | split: ','
  assign same_as_links = ''
  for handle in social_handles
    assign social_key = 'social_' | append: handle | append: '_link'
    if settings[social_key] != blank
      assign encoded_link = settings[social_key] | json
      if same_as_links == ''
        assign same_as_links = encoded_link
      else
        assign same_as_links = same_as_links | append: ',' | append: encoded_link
      endif
    endif
  endfor
-%}
<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if section.settings.logo %}
      "logo": {{ section.settings.logo | image_url: width: section.settings.logo.width | prepend: "https:" | json }},
    {% endif %}
    "sameAs": [{{ same_as_links }}],
    "url": {{ shop.url | json }}
  }
</script>

{%- if request.page_type == 'index' -%}
  {% assign potential_action_target = request.origin | append: routes.search_url | append: '?q={search_term_string}' %}
  <script type="application/ld+json">
    {
      "@context": "http://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ potential_action_target | json }},
        "query-input": "required name=search_term_string"
      },
      "url": {{ shop.url | json }}
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Header",
  "class": "z-10",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_sticky_header",
      "default": true,
      "label": "Enable sticky header",
      "info": "Header shows on the screen as customers scroll up."
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Used in search-engine structured data (Organization logo)."
    }
  ]
}
{% endschema %}
