{%- comment -%}
  README
  Four Column Grid — Content grid with image, heading, description, and link per column.

  Displays up to 4 columns in a row on desktop, stacked on mobile. Each column
  has a centered image, heading, description, and a link. Links can be styled
  as either underlined text links or filled pill buttons at the section level.
  Button colors are managed via a scoped style block.

  Section settings:
  | Setting          | Type   | Required |
  |------------------|--------|----------|
  | background_color | color  | No       |
  | link_style       | select | No       |
  | button_color     | color  | No       |
  | button_text_color| color  | No       |

  Block settings (column):
  | Setting     | Type         | Required |
  |-------------|--------------|----------|
  | image       | image_picker | No       |
  | heading     | text         | No       |
  | description | textarea     | No       |
  | link_label  | text         | No       |
  | link_url    | url          | No       |
{%- endcomment -%}

<style>
  #FourColumnGrid-{{ section.id }} {
    {%- if section.settings.background_color != blank %}
      background-color: {{ section.settings.background_color }};
    {%- endif %}
  }
  {%- if section.settings.link_style == 'button' %}
    #FourColumnGrid-{{ section.id }} .fcg-btn {
      {%- if section.settings.button_color != blank %}
        background-color: {{ section.settings.button_color }};
        border-color: {{ section.settings.button_color }};
      {%- endif %}
      {%- if section.settings.button_text_color != blank %}
        color: {{ section.settings.button_text_color }};
      {%- endif %}
    }
  {%- endif %}
</style>

<div
  id="FourColumnGrid-{{ section.id }}"
  class="px-4 py-24 md:px-16"
>
  {%- if section.blocks.size > 0 -%}
    <div class="grid gap-12 md:grid-cols-4 md:gap-12">
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }} class="text-center">
          {%- if block.settings.image != blank -%}
            <div class="mb-6 flex justify-center">
              {%- assign image_height = block.settings.image.width | divided_by: block.settings.image.aspect_ratio -%}
              {{
                block.settings.image
                | image_url: width: 216
                | image_tag:
                  loading: 'lazy',
                  width: block.settings.image.width,
                  height: image_height,
                  class: 'block size-28 object-cover',
                  sizes: '108px',
                  widths: '108, 216',
                  alt: block.settings.image.alt
                | escape
              }}
            </div>
          {%- endif -%}

          {%- if block.settings.heading != blank -%}
            <h3 class="font-heading text-2xl leading-snug mb-1">
              {{- block.settings.heading | escape -}}
            </h3>
          {%- endif -%}

          {%- if block.settings.description != blank -%}
            <p class="text-base leading-relaxed mb-9">
              {{- block.settings.description | escape -}}
            </p>
          {%- endif -%}

          {%- if block.settings.link_label != blank -%}
            {%- if section.settings.link_style == 'button' -%}
              <div>
                <a
                  {% if block.settings.link_url != blank %}href="{{ block.settings.link_url }}"{% endif %}
                  class="fcg-btn inline-flex cursor-pointer items-center justify-center rounded-full border border-current px-6 py-3 text-base transition hover:opacity-90"
                >
                  {{- block.settings.link_label | escape -}}
                </a>
              </div>
            {%- else -%}
              <div>
                <a
                  {% if block.settings.link_url != blank %}href="{{ block.settings.link_url }}"{% endif %}
                  class="inline-block border-b border-current pb-0.5 text-base leading-relaxed"
                >
                  {{- block.settings.link_label | escape -}}
                </a>
              </div>
            {%- endif -%}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Four column grid",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "header",
      "content": "Links"
    },
    {
      "type": "select",
      "id": "link_style",
      "options": [
        {
          "value": "text",
          "label": "Text link"
        },
        {
          "value": "button",
          "label": "Button"
        }
      ],
      "default": "text",
      "label": "Link style"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button color",
      "info": "Only applies when link style is set to Button."
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "info": "Only applies when link style is set to Button."
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Savory Spice"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Our flavors transform everyday cooking into a shared, meaningful experience, delivering quality and innovation in everything we do."
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Text Link"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Four column grid",
      "category": "Content",
      "blocks": [
        {
          "type": "column",
          "settings": {
            "heading": "Savory Spice",
            "description": "Our flavors transform everyday cooking into a shared, meaningful experience, delivering quality and innovation in everything we do.",
            "link_label": "Text Link"
          }
        },
        {
          "type": "column",
          "settings": {
            "heading": "Savory Spice",
            "description": "Our flavors transform everyday cooking into a shared, meaningful experience, delivering quality and innovation in everything we do.",
            "link_label": "Text Link"
          }
        },
        {
          "type": "column",
          "settings": {
            "heading": "Savory Spice",
            "description": "Our flavors transform everyday cooking into a shared, meaningful experience, delivering quality and innovation in everything we do.",
            "link_label": "Text Link"
          }
        },
        {
          "type": "column",
          "settings": {
            "heading": "Savory Spice",
            "description": "Our flavors transform everyday cooking into a shared, meaningful experience, delivering quality and innovation in everything we do.",
            "link_label": "Text Link"
          }
        }
      ]
    }
  ],
  "max_blocks": 4
}
{% endschema %}
