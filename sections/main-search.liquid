<div class="grid w-full justify-items-start gap-8 p-6 py-8 md:p-8 lg:p-12">
  {%- content_for 'block', type: 'heading', id: 'heading', wrapper_class: 'max-w-prose' -%}
  {%- content_for 'block', type: 'search-input', id: 'search-input' -%}
</div>

{% if search.performed %}
  {%- if search.results_count == 0 -%}
    <div class="grid w-full gap-4 px-6 md:gap-8 md:px-8 lg:px-12">
      <p class="max-w-prose text-copy opacity-50">
        {{ 'general.search.no_results_html' | t: terms: search.terms | replace: '*', '' }}
      </p>
    </div>
  {%- endif -%}
  {%- if search.results_count != 0 -%}
    {% paginate search.results by 24 %}
      <div class="grid w-full grid-flow-row grid-cols-2 gap-2 gap-y-6 p-6 sm:grid-cols-3 md:gap-4 md:p-8 lg:grid-cols-4 lg:gap-6 lg:p-12">
        {%- liquid
          # Search is limited to products via type=product on the search forms,
          # but guard on object_type so widening the search scope later can't
          # render articles/pages through the product card.
          assign card_sizes = '(min-width: 1024px) 25vw, (min-width: 640px) 33vw, 50vw'
          for item in search.results
            if item.object_type != 'product'
              continue
            endif
            assign lazy_load = false
            if forloop.index > 2
              assign lazy_load = true
            endif
            content_for 'block', type: 'product-card', id: 'static-product-card', closest.product: item, lazy_load: lazy_load, sizes: card_sizes
          endfor
        -%}
      </div>
      <div class="px-6 pb-8 md:px-8 lg:px-12">
        {%- render 'pagination', paginate: paginate -%}
      </div>
    {% endpaginate %}
  {%- endif -%}
{% endif %}

{% schema %}
{
  "name": "Search results",
  "enabled_on": {
    "templates": ["search"]
  }
}
{% endschema %}
