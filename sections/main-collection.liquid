<div id="ProductGridContainer" class="grid w-full gap-4 border-none p-6 md:gap-8 md:p-8 lg:p-12">
  {%- paginate collection.products by 12 -%}
    <div
      class="grid grid-flow-row grid-cols-2 gap-2 gap-y-6 md:grid-cols-3 md:gap-4 lg:grid-cols-4 lg:gap-6"
      id="product-grid"
      data-id="{{ section.id }}"
    >
      {%- liquid
        assign card_sizes = '(min-width: 1024px) 25vw, (min-width: 768px) 33vw, 50vw'
        for product in collection.products
          assign lazy_load = false
          assign fetch_priority = null
          if forloop.index > 2
            assign lazy_load = true
          elsif forloop.first
            assign fetch_priority = 'high'
          endif
          content_for 'block', type: 'product-card', id: 'static-product-card', closest.product: product, lazy_load: lazy_load, sizes: card_sizes, fetchpriority: fetch_priority
        endfor
      -%}
    </div>
    {%- render 'pagination', paginate: paginate, anchor: '#product-grid' -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Collection products",
  "enabled_on": {
    "templates": ["collection"]
  }
}
{% endschema %}
