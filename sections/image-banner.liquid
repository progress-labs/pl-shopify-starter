{%- comment -%}
  README
  Media Billboard — Full-screen hero banner with background media and overlaid content.

  Displays a full-viewport-height background image or video with text content
  overlaid on top. Content position is configurable on both vertical (top,
  center, bottom) and horizontal (left, center, right) axes. Text alignment
  follows the horizontal position. Includes an optional dark overlay with
  adjustable opacity for text contrast. The CTA supports button or text link
  styles. Video uses the <video-player> island with play/pause and mute
  controls positioned opposite the content.

  Section settings:
  | Setting             | Type         | Required |
  |---------------------|--------------|----------|
  | image               | image_picker | No       |
  | video               | video        | No       |
  | eyebrow             | text         | No       |
  | heading             | text         | No       |
  | description         | textarea     | No       |
  | text_color          | color        | No       |
  | vertical_position   | select       | No       |
  | horizontal_position | select       | No       |
  | button_style        | select       | No       |
  | button_label        | text         | No       |
  | button_link         | url          | No       |
  | button_color        | color        | No       |
  | button_text_color   | color        | No       |
  | overlay_enable      | checkbox     | No       |
  | overlay_opacity     | range        | No       |
{%- endcomment -%}

{%- liquid
  assign loading = 'eager'
  assign preload = true
  assign fetchpriority = 'high'
  if section.index0 > 0
    assign loading = 'lazy'
    assign preload = false
    assign fetchpriority = 'auto'
  endif

  assign vertical = section.settings.vertical_position
  assign horizontal = section.settings.horizontal_position

  case vertical
    when 'top'
      assign items_y = 'items-start'
    when 'center'
      assign items_y = 'items-center'
    when 'bottom'
      assign items_y = 'items-end'
  endcase

  case horizontal
    when 'left'
      assign items_x = 'justify-start'
      assign text_align = 'text-left'
      assign controls_position = 'right-4 md:right-16'
    when 'center'
      assign items_x = 'justify-center'
      assign text_align = 'text-center'
      assign controls_position = 'right-4 md:right-16'
    when 'right'
      assign items_x = 'justify-end'
      assign text_align = 'text-right'
      assign controls_position = 'left-4 md:left-16'
  endcase
-%}

<style>
  #MediaBillboard-{{ section.id }} {
    {%- if section.settings.text_color != blank %}
      color: {{ section.settings.text_color }};
    {%- endif %}
  }
  #MediaBillboard-{{ section.id }} .ib-btn {
    {%- if section.settings.button_color != blank %}
      background-color: {{ section.settings.button_color }};
    {%- endif %}
    {%- if section.settings.button_text_color != blank %}
      color: {{ section.settings.button_text_color }};
    {%- endif %}
  }
  {%- if section.settings.overlay_enable %}
    #MediaBillboard-{{ section.id }} .ib-overlay {
      background: rgba(0, 0, 0, {{ section.settings.overlay_opacity | divided_by: 100.0 }});
    }
  {%- endif %}
</style>

<div
  id="MediaBillboard-{{ section.id }}"
  class="relative flex min-h-svh overflow-hidden px-4 py-20 md:px-16 md:py-24 {{ items_y }} {{ items_x }}"
>
  {% # Background media %}
  {%- if section.settings.video != blank -%}
    <video-player client:visible class="group absolute inset-0 z-0" data-state="playing" data-muted="true">
      <video
        class="block size-full object-cover"
        style="aspect-ratio: {{ section.settings.video.aspect_ratio }};"
        autoplay
        muted
        loop
        playsinline
        {% if section.settings.image != blank %}
          poster="{{ section.settings.image | image_url: width: 1920 }}"
        {% endif %}
      >
        {%- for source in section.settings.video.sources -%}
          <source src="{{ source.url }}" type="{{ source.mime_type }}">
        {%- endfor -%}
      </video>
      <div class="absolute bottom-4 z-20 flex gap-4 {{ controls_position }}">
        <button
          type="button"
          data-play
          class="cursor-pointer text-white opacity-85 transition-opacity hover:opacity-100"
          aria-label="Play / Pause"
        >
          <span class="block group-data-[state=playing]:hidden">{%- render 'icon-play' -%}</span>
          <span class="hidden group-data-[state=playing]:block">{%- render 'icon-pause' -%}</span>
        </button>
        <button
          type="button"
          data-mute
          class="cursor-pointer text-white opacity-85 transition-opacity hover:opacity-100"
          aria-label="Mute / Unmute"
        >
          <span class="block group-data-[muted=true]:hidden">{%- render 'icon-volume' -%}</span>
          <span class="hidden group-data-[muted=true]:block">{%- render 'icon-volume-mute' -%}</span>
        </button>
      </div>
    </video-player>
  {%- elsif section.settings.image != blank -%}
    <div class="pointer-events-none absolute inset-0 z-0">
      {%- assign image_height = section.settings.image.width | divided_by: section.settings.image.aspect_ratio -%}
      {{
        section.settings.image
        | image_url: width: 3840
        | image_tag:
          loading: loading,
          preload: preload,
          fetchpriority: fetchpriority,
          width: section.settings.image.width,
          height: image_height,
          class: 'block size-full object-cover',
          sizes: '100vw',
          widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840',
          alt: section.settings.image.alt
      }}
    </div>
  {%- else -%}
    <div class="pointer-events-none absolute inset-0 z-0">
      {{ 'lifestyle-2' | placeholder_svg_tag: 'size-full object-cover fill-primary/20' }}
    </div>
  {%- endif -%}

  {% # Overlay %}
  {%- if section.settings.overlay_enable -%}
    <div class="ib-overlay pointer-events-none absolute inset-0 z-5"></div>
  {%- endif -%}

  {% # Content %}
  <div class="z-10 max-w-xl {{ text_align }}">
    {%- if section.settings.eyebrow != blank -%}
      <p class="mb-4 text-sm font-semibold tracking-widest uppercase md:mb-10 md:text-base">
        {{- section.settings.eyebrow | escape -}}
      </p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="mb-2 font-heading text-5xl leading-none md:mb-2 md:text-7xl">
        {{- section.settings.heading | escape -}}
      </h2>
    {%- endif -%}

    {%- if section.settings.description != blank -%}
      <p class="mb-8 text-base leading-relaxed">
        {{- section.settings.description | escape -}}
      </p>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      {%- if section.settings.button_style == 'button' -%}
        <div>
          <a
            {% if section.settings.button_link != blank %}
              href="{{ section.settings.button_link }}"
            {% endif %}
            class="ib-btn inline-flex cursor-pointer items-center justify-center rounded-full px-6 py-3 text-base transition hover:opacity-90"
          >
            {{- section.settings.button_label | escape -}}
          </a>
        </div>
      {%- else -%}
        <div>
          <a
            {% if section.settings.button_link != blank %}
              href="{{ section.settings.button_link }}"
            {% endif %}
            class="inline-block cursor-pointer border-b border-current pb-0.5 text-base leading-relaxed"
          >
            {{- section.settings.button_label | escape -}}
          </a>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Media billboard",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Also used as the video poster frame when a video is set."
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "When set, the video replaces the image. Autoplays muted and loops."
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "info": "Optional small text above the heading."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "We turn everyday meals into moments of connection and joy."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Our flavors transform everyday cooking into a shared, meaningful experience, delivering quality and innovation in everything we do."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color"
    },
    {
      "type": "select",
      "id": "vertical_position",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "top",
      "label": "Vertical position"
    },
    {
      "type": "select",
      "id": "horizontal_position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left",
      "label": "Horizontal position"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "select",
      "id": "button_style",
      "options": [
        { "value": "button", "label": "Button" },
        { "value": "text", "label": "Text link" }
      ],
      "default": "button",
      "label": "Button style"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button color"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color"
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "checkbox",
      "id": "overlay_enable",
      "label": "Enable overlay",
      "default": false,
      "info": "Add a dark overlay on the media for better text contrast."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 20,
      "unit": "%",
      "info": "Only applies when overlay is enabled."
    }
  ],
  "presets": [
    {
      "name": "Media billboard",
      "category": "Banners",
      "settings": {
        "heading": "We turn everyday meals into moments of connection and joy.",
        "description": "Our flavors transform everyday cooking into a shared, meaningful experience, delivering quality and innovation in everything we do.",
        "button_label": "Learn More"
      }
    }
  ]
}
{% endschema %}
