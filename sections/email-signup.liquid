{%- comment -%}
  README
  Email Signup — Klaviyo newsletter subscription section.

  Centered heading and description with an email input and submit button.
  Uses the <newsletter-form> island for Klaviyo integration. The button can
  be displayed inline beside the input or stacked beneath it. On mobile the
  layout always stacks vertically.

  Section settings:
  | Setting          | Type     | Required |
  |------------------|----------|----------|
  | heading          | text     | No       |
  | description      | textarea | No       |
  | placeholder      | text     | No       |
  | button_label     | text     | No       |
  | button_color     | color    | No       |
  | button_text_color| color    | No       |
  | button_layout    | select   | No       |
  | background_color | color    | No       |
{%- endcomment -%}

<div
  id="EmailSignup-{{ section.id }}"
  class="grid justify-items-center px-4 py-24 md:px-16 md:py-24"
  {% if section.settings.background_color != blank %}
    style="background-color: {{ section.settings.background_color }};"
  {% endif %}
>
  <newsletter-form client:visible class="mx-auto grid w-full max-w-2xl gap-6">
    <form class="grid gap-6">
      <div class="grid gap-3">
        {%- if section.settings.heading != blank -%}
          <h2 class="font-heading text-5xl leading-none md:text-center md:text-7xl">
            {{- section.settings.heading | escape -}}
          </h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <p class="text-base leading-relaxed md:text-center">
            {{- section.settings.description | escape -}}
          </p>
        {%- endif -%}
      </div>

      {%- capture input_field -%}
        <div class="w-full border-b border-current px-0.5 py-3">
          <input
            type="email"
            name="email"
            required
            placeholder="{{ section.settings.placeholder | escape }}"
            class="w-full border-none bg-transparent font-heading text-xl leading-tight placeholder-current/30 outline-none md:text-3xl md:leading-snug"
          >
        </div>
      {%- endcapture -%}

      {%- capture submit_button -%}
        <div>
          <button
            type="submit"
            class="w-full rounded-full px-6 py-3 text-base transition hover:opacity-90 md:w-auto"
            {% if section.settings.button_color != blank and section.settings.button_text_color != blank %}
              style="background-color: {{ section.settings.button_color }}; color: {{ section.settings.button_text_color }};"
            {% endif %}
          >
            {{- section.settings.button_label | default: 'Join' | escape -}}
          </button>
        </div>
      {%- endcapture -%}

      {%- if section.settings.button_layout == 'inline' -%}
        <div class="grid gap-6 md:grid-cols-12 md:items-end">
          <div class="md:col-span-9">
            {{ input_field }}
          </div>
          <div class="md:col-span-3">
            {{ submit_button }}
          </div>
        </div>
      {%- else -%}
        <div class="grid justify-items-center gap-6">
          {{ input_field }}
          {{ submit_button }}
        </div>
      {%- endif -%}

      <span data-message hidden class="text-sm md:text-center"></span>
    </form>
  </newsletter-form>
</div>

{% schema %}
{
  "name": "Email signup",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join our community"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Our flavors transform everyday cooking into a shared, meaningful experience, delivering quality and innovation in everything we do."
    },
    {
      "type": "header",
      "content": "Form"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input placeholder",
      "default": "Your Email *"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Join"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button color"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color"
    },
    {
      "type": "select",
      "id": "button_layout",
      "options": [
        {
          "value": "stacked",
          "label": "Stacked"
        },
        {
          "value": "inline",
          "label": "Inline"
        }
      ],
      "default": "stacked",
      "label": "Button layout",
      "info": "Inline places the button next to the input on desktop."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    }
  ],
  "presets": [
    {
      "name": "Email signup",
      "category": "Newsletter"
    }
  ]
}
{% endschema %}
